/* =========================================================================
   CUSTOMER FEEDBACK ANALYTICS - PRODUCTION DAX MEASURES PACKAGE
   Ready to paste into Power BI Desktop (Modeling > New Measure)
   ========================================================================= */

// 1. VOLUME METRICS
Total Feedback = COUNTROWS(Fact_CustomerFeedback)

Feedback With Comments = 
CALCULATE(
    COUNTROWS(Fact_CustomerFeedback),
    LEN(Fact_CustomerFeedback[FeedbackText]) > 0
)

// 2. RATING & SATISFACTION METRICS
Average Rating = 
ROUND(AVERAGE(Fact_CustomerFeedback[Rating]), 2)

Promoter Count = 
CALCULATE(
    COUNTROWS(Fact_CustomerFeedback),
    Fact_CustomerFeedback[IsPromoter] = 1
)

Passive Count = 
CALCULATE(
    COUNTROWS(Fact_CustomerFeedback),
    Fact_CustomerFeedback[IsPassive] = 1
)

Detractor Count = 
CALCULATE(
    COUNTROWS(Fact_CustomerFeedback),
    Fact_CustomerFeedback[IsDetractor] = 1
)

// 3. NET PROMOTER SCORE (NPS) [-100 to +100]
NPS Score = 
VAR TotalCount = [Total Feedback]
VAR Promoters = [Promoter Count]
VAR Detractors = [Detractor Count]
RETURN
IF(
    TotalCount > 0,
    ROUND(DIVIDE(Promoters - Detractors, TotalCount, 0) * 100, 1),
    0
)

// 4. CSAT % (Customer Satisfaction Percentage)
CSAT Percentage = 
VAR TotalCount = [Total Feedback]
VAR Promoters = [Promoter Count]
RETURN
IF(
    TotalCount > 0,
    DIVIDE(Promoters, TotalCount, 0),
    0
)

// 5. DETRACTOR RATE %
Detractor Rate = 
VAR TotalCount = [Total Feedback]
VAR Detractors = [Detractor Count]
RETURN
IF(
    TotalCount > 0,
    DIVIDE(Detractors, TotalCount, 0),
    0
)

// 6. TIME INTELLIGENCE: MONTH-OVER-MONTH (MoM) RATING DELTA
Rating Previous Month = 
CALCULATE(
    [Average Rating],
    PREVIOUSMONTH(Dim_Date[Date])
)

MoM Rating Change = 
VAR Prev = [Rating Previous Month]
RETURN
IF(
    ISBLANK(Prev),
    BLANK(),
    [Average Rating] - Prev
)

// 7. ENTERPRISE HIGH-RISK ESCALATIONS
Enterprise Detractors = 
CALCULATE(
    [Detractor Count],
    RELATED(Dim_Product[ProductTier]) = "Enterprise"
)

// 8. SENTIMENT CONTRADICTION DETECTION
// Flags cases where Rating is 5 (Promoter) but Text or Sentiment is Negative
Contradiction Count = 
CALCULATE(
    COUNTROWS(Fact_CustomerFeedback),
    Fact_CustomerFeedback[Rating] = 5,
    Fact_CustomerFeedback[SentimentKey] = 1
)
